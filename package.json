{
  "name": "wad-trip-planner",
  "version": "1.0.0",
  "description": "Full-Stack Trip Planner Web Application",
  "main": "server/server.js",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,magenta\" \"node server/server.js\" \"cd client && npm run dev\"",
    "server": "node server/server.js",
    "client": "cd client && npm run dev",
    "seed": "node server/seed.js",
    "sync:firestore": "node server/sync_to_firestore.cjs",
    "build": "cd client && npm run build",
    "deploy": "npm run build && npx -y firebase-tools deploy --only hosting",
    "start": "node server/server.js"
  },
  "keywords": [
    "travel",
    "trip-planner",
    "itinerary",
    "full-stack",
    "react",
    "express",
    "sqlite"
  ],
  "author": "Antigravity",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "firebase": "^12.19.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
